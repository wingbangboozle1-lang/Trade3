# Copy to .env (or export in your shell) and NEVER commit real keys.
# Create a DEMO key: https://demo.kalshi.co/ -> Account & security -> API Keys
# Demo keys only work against demo hosts; production keys only against production.
KALSHI_API_KEY_ID=your-demo-api-key-id

# Supply the private key material one of two ways. The PEM variable keeps the key
# out of the filesystem entirely; the path variant reads a local file.
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
KALSHI_PRIVATE_KEY_PATH=./kalshi-key.pem

KALSHI_ENV=demo
KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2

# Live orders stay OFF unless this is explicitly 1. The paper engine never needs it.
# KALSHI_ALLOW_ORDERS=1

# Data mode: live (default) | snapshot (committed real capture) | demo (synthetic)
DATA_MODE=live
# With 0, an unreachable API is reported instead of silently switching to synthetic data.
ALLOW_DEMO_FALLBACK=0
